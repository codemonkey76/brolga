{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brolga",
  "identifier": "io.github.codemonkey76.Brolga",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brolga",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Mail, calendar and contacts for Microsoft 365",
    "longDescription": "A desktop client for Microsoft 365 mail, calendar and contacts. It works offline, shows messages without running anything in them or loading remote pictures unasked, and everything it does is also a command for the command line and for AI agents.",
    "license": "MIT",
    "homepage": "https://github.com/codemonkey76/brolga",
    "linux": {
      "deb": {
        "desktopTemplate": "../../packaging/linux/brolga.desktop",
        "section": "mail",
        "files": {
          "/usr/share/metainfo/io.github.codemonkey76.Brolga.metainfo.xml": "../../packaging/linux/io.github.codemonkey76.Brolga.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "../../packaging/linux/brolga.desktop",
        "files": {
          "/usr/share/metainfo/io.github.codemonkey76.Brolga.metainfo.xml": "../../packaging/linux/io.github.codemonkey76.Brolga.metainfo.xml"
        }
      }
    },
    "publisher": "Shane Poppleton",
    "copyright": "Copyright © 2026 Shane Poppleton"
  }
}
